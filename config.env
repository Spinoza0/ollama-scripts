# =============================================================================
# Конфигурация Ollama
# =============================================================================
# Этот файл содержит параметры для всех скриптов
# =============================================================================

# Модель по умолчанию
# Доступные модели: https://ollama.com/library
MODEL="qwen3.8:27b-mlx"

# Хост сервера
HOST="127.0.0.1"

# Порт сервера
PORT="11434"

# URL API
API_URL="http://${HOST}:${PORT}"

# Как долго модель остаётся загруженной в памяти после последнего запроса
# (ollama run --keepalive и OLLAMA_KEEP_ALIVE для сервера)
KEEP_ALIVE="10m"
